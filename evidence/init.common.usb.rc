on boot
    write /sys/class/android_usb/android0/iSerial ${ro.serialno}
    mount configfs none /config
    mkdir /config/usb_gadget/g1 0770
    mkdir /config/usb_gadget/g1/strings/0x409 0770
    write /config/usb_gadget/g1/bcdUSB 0x0200
    write /config/usb_gadget/g1/os_desc/use 1
    write /config/usb_gadget/g1/strings/0x409/serialnumber ${ro.serialno}
    write /config/usb_gadget/g1/strings/0x409/manufacturer ${ro.product.manufacturer}
    write /config/usb_gadget/g1/strings/0x409/product ${ro.product.model}
    mkdir /config/usb_gadget/g1/functions/ffs.adb
    mkdir /config/usb_gadget/g1/functions/diag.diag
    mkdir /config/usb_gadget/g1/configs/b.1 0770 shell shell
    mkdir /config/usb_gadget/g1/configs/b.1/strings/0x409 0770 shell shell
    write /config/usb_gadget/g1/os_desc/b_vendor_code 0x1
    write /config/usb_gadget/g1/os_desc/qw_sign "MSFT100"
    mkdir /config/usb_gadget/g1/functions/accessory.gs2
    symlink /config/usb_gadget/g1/configs/b.1 /config/usb_gadget/g1/os_desc/b.1
    mkdir /dev/usb-ffs 0775 shell system
    mkdir /dev/usb-ffs/adb 0770 shell system
    mount functionfs adb /dev/usb-ffs/adb uid=2000,gid=2000
    write /sys/class/android_usb/android0/f_ffs/aliases adb

    chown root system /sys/devices/platform/msm_hsusb/gadget/wakeup
    chmod 0220 /sys/devices/platform/msm_hsusb/gadget/wakeup

    setprop sys.usb.controller "a800000.dwc3"
    setprop sys.usb.configfs 1
    setprop ro.vendor.audio.usb.period_us 10000

# USB compositions
on property:sys.usb.config=adb && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/idVendor 0x2ec6
    write /config/usb_gadget/g1/idProduct ${ro.hw.usb.idproduct.adb}

on property:sys.usb.config=accessory && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/idVendor 0x18d1
    write /config/usb_gadget/g1/idProduct 0x2d00

on property:sys.usb.config=accessory,adb && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/idVendor 0x18d1
    write /config/usb_gadget/g1/idProduct 0x2d01

on property:ro.boot.force_enable_usb_adb=1 && property:ro.build.type=user && property:sys.usb.config=none
    setprop persist.sys.usb.config adb

# Enable adb for *_vendor-user build flavor
on boot && property:ro.build.type=user
    setprop ro.vendor.build.flavor ${ro.build.flavor}

on property:ro.vendor.build.flavor=aloha_vendor-user
    setprop persist.sys.usb.config adb

on property:ro.vendor.build.flavor=ripley_vendor-user
    setprop persist.sys.usb.config adb

# Ensure adb is disabled if bootloader says so
# Do it only for user lunch, otherwise it would break aloha_vendor use case
on property:ro.boot.force_enable_usb_adb=0 && property:ro.vendor.build.flavor=aloha_prod-user
    setprop persist.vendor.usb.config none
    setprop sys.usb.config none
    write /sys/class/android_usb/android0/enable 0
    stop adbd
    write /sys/class/android_usb/android0/bDeviceClass 0
    setprop sys.usb.state none
    setprop sys.usb.configfs none

# Ensure adb is disabled if bootloader says so
# Do it only for user lunch, otherwise it would break ripley_vendor use case
on property:ro.boot.force_enable_usb_adb=0 && property:ro.vendor.build.flavor=ripley_prod-user
    setprop persist.vendor.usb.config none
    setprop sys.usb.config none
    write /sys/class/android_usb/android0/enable 0
    stop adbd
    write /sys/class/android_usb/android0/bDeviceClass 0
    setprop sys.usb.state none
    setprop sys.usb.configfs none
